#include <env/nxp/imx_env.env>

#ifdef CONFIG_AHAB_BOOT
sec_boot=yes
#else
sec_boot=no
#endif

initrd_addr=0x93800000
initrd_high=0xffffffffffffffff
emmc_dev=0
sd_dev=1

prepare_mcore=setenv mcore_args clk_ignore_unused pd_ignore_unused;
cpuidle=
scriptaddr=0x93500000
kernel_addr_r=CONFIG_SYS_LOAD_ADDR
image=Image.gz
img_addr=0xB0000000
splashimage=0xA0000000
splashfile=/boot/splash.bmp
splashsourceauto=yes
splashpos=m,m
backlight_disable=gpio clear GPIO2_25
backlight_enable=gpio set GPIO2_25
console=ttyLP0,115200 earlycon
fdt_addr_r=0x93000000
fdt_addr=0x93000000
fdt_high=0xffffffffffffffff
nfsroot=/srv/nfs/CONFIG_SYS_BOARD/rootfs
cntr_addr=0xA8000000
cntr_file=os_cntr_signed.bin
bootdir=/boot
fdt_file=undefined
boot_fit=no
boot_targets=usb0 mmc0 mmc1 dhcp
bootm_size=0x10000000
mmcdev=CONFIG_ENV_MMC_DEVICE_INDEX
mmcpart=1
mmcautodetect=yes
optargs=setenv bootargs ${bootargs} ${kernelargs};
mmcargs=setenv bootargs ${cpuidle} ${mcore_args} console=${console} root=/dev/mmcblk${mmcblk}p${mmcpart} rootwait rw
script=boot.scr
bootenv=uEnv.txt
loadbootscript=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bootdir}/${script};
bootscript=echo Running bootscript from mmc ...; source
loadbootenv=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bootdir}/${bootenv}
importbootenv=echo Importing environment from mmc ...; env import -t -r $loadaddr $filesize
loadimage=load mmc ${mmcdev}:${mmcpart} ${img_addr} ${bootdir}/${image}; unzip ${img_addr} ${loadaddr}
findfdt=if test $fdt_file = undefined; then setenv fdt_file imx95-var-dart-${carrier_name}${m7_dtb_suffix}.dtb; fi;
loadfdt=run findfdt; echo fdt_file=${fdt_file}; load mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${bootdir}/${fdt_file}
loadcntr=load mmc ${mmcdev}:${mmcpart} ${cntr_addr} ${bootdir}/${cntr_file}
auth_os=booti ${cntr_addr}
boot_os=booti ${loadaddr} - ${fdt_addr_r};
m7_load_addr=0x90000000
m7_addr=0x203c0000
m7_addr_auxview=0x00000000
m7_bin=hello_world.bin
use_m7=no
loadm7bin=load mmc ${mmcdev}:${mmcpart} ${m7_load_addr} ${bootdir}/${m7_bin} && cp.b ${m7_load_addr} ${m7_addr} ${filesize};
runm7bin=echo Booting M7 from TCM; stopaux 1; prepaux 1; bootaux ${m7_addr_auxview} 1;
mmcboot=echo Booting from mmc ...; run mmcargs; run optargs; run backlight_disable; if test ${sec_boot} = yes; then run auth_os; else if test ${boot_fit} = yes || test ${boot_fit} = try; then bootm ${loadaddr}; else if run loadfdt; then run boot_os; else echo WARN: Cannot load the DT; fi; fi; fi;
netargs=setenv bootargs ${mcore_args} console=${console} root=/dev/nfs ip=dhcp nfsroot=${serverip}:${nfsroot},v3,tcp
netboot=echo Booting from net ...; run netargs; run optargs; if test ${ip_dyn} = yes; then setenv get_cmd dhcp; else setenv get_cmd tftp; fi; if test ${sec_boot} = yes; then ${get_cmd} ${cntr_addr} ${cntr_file}; run auth_os; else ${get_cmd} ${img_addr} ${image}; unzip ${img_addr} ${loadaddr}; if test ${boot_fit} = yes || test ${boot_fit} = try; then bootm ${loadaddr}; else run findfdt; if ${get_cmd} ${fdt_addr_r} ${fdt_file}; then run boot_os; else echo WARN: Cannot load the DT; fi; fi; fi;
bsp_bootcmd=echo Running BSP bootcmd ...; if env exists mender_setup; then run mender_setup; fi; mmc dev ${mmcdev}; if mmc rescan; then if test ${use_m7} = yes && run loadm7bin; then run prepare_mcore; run runm7bin; fi; if run loadbootscript; then run bootscript; else if test ${sec_boot} = yes; then if run loadcntr; then run mmcboot; else run netboot; fi; else if run loadbootenv; then echo Loaded environment from ${bootenv}; run importbootenv; fi; if run loadimage; then run mmcboot; else run netboot; fi; fi; fi; fi;
